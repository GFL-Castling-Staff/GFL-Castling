<?xml version="1.0" encoding="utf-8"?>
<vehicle name="flare" key="qwd_spawn.vehicle" map_view_atlas_index="-1" allow_ai_to_use="0" should_be_destroyed="0" usable_for_cover="0" respawn_time="36000" time_to_live="0.1" >
