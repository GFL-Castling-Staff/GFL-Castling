<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" 
name="Aegis" 
key="kcco_aa_aegis.vehicle" 
map_view_atlas_index="57" 
allow_ai_to_use="1" 
respawn_time="360" 
owner="faction" 
existence="one_per_faction"
time_to_live_unsteerable="355"
max_character_collision_speed_on_normal="60.0" 
max_character_collision_speed="60" 
minimum_fill_requirement="1.0"
allow_owner_to_use_only="1"
ai_abandon_when_unsteerable="1"
ai_driver_turns_to_target="1"
ai_stop_to_fight="1"
character_leave_request_mode="friendly"
reserves_spawn_point="1"
soldier_capacity_offset="20"
>
	
	<tag name="metal_heavy" />
	<tag name="truck" />
	<tag name="trans_truck" />
	<tag name="any_tank" />  

	<tire_set offset="1.35 0.0 1.35" radius="0.1" />
	<tire_set offset="1.35 0.0 0" radius="0.1" />
	<!-- 如果想做坦克这必须要做成三对轮胎，否则转弯时会各种翘 -->
	<tire_set offset="1.35 0.0 -1.35" radius="0.1" />

	<control 
	max_speed="10" 
	max_limiter_speed="10"
	acceleration="12.0" 
	max_reverse_speed="10.0" 
	min_health_to_steer="5" 
	max_rotation="0" 
	max_water_depth="2.0" 
	steer_smoothening="0.98" tracked="1" simulated_speed_factor="0.2"
	tracked_visual_tire_max_rotation="1.0" tracked_visual_tire_rotation_smoothening="1"/>

	<physics 
	max_health="100.0" 
    blast_damage_threshold="3.0" 
	mass="450.0"
    drag_offset="-0.5" friction_offset="-0.1" 
    destroy_on_top_hit="1"
	destroy_on_top_hit_time="2.0"
	gravity="-70"
	broken_mass="300.0"
    remove_collision_threshold="0.5"	
	extent="4.2 3.0 5.2" 
	offset="0 0.0 0" 
	top_offset="0 3 0" 
	collision_model_pos="0 1.0 0" 
	collision_model_extent="4.2 2.0 5.2" 
    simulated_speed_factor="1.0"
	visual_offset="0 0.5 0.5" /> 

    <turret offset="0 2.8 0" weapon_key="kcco_aegis_eye" weapon_offset="0.0 0.0 0" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.003" rotation_range="6.28" />
    <turret offset="1.1 2.2 0" weapon_key="kcco_aegis_cannon" weapon_offset="0.0 0.0 0" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.003" rotation_range="0.03" />
    <turret offset="-1.1 2.2 0" weapon_key="kcco_aegis_cannon" weapon_offset="0.0 0.0 0" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.003" rotation_range="0.03" />
    <turret offset="0 30 0" weapon_key="kcco_aegis_aim" weapon_offset="0.0 0.0 0" weapon_recoil="0.0" physics_recoil="0.0" max_rotation_step="0.003" rotation_range="0.03" />

	<visual class="chassis" mesh_filename="aegis_body.mesh" texture_filename="aegis_body.png" />
	<visual class="chassis" key="broken" mesh_filename="aegis_body.mesh" texture_filename="armored_truck_broken.png" />

	<visual class="turret" turret_index="0" offset="0 100 0" mesh_filename="empty.mesh" texture_filename="none.png"/>
	<visual class="turret" turret_index="0" offset="0 100 0" key="broken" mesh_filename="empty.mesh" texture_filename="none.png"/>

	<visual  offset="0 0 0" class="turret" turret_index="1" mesh_filename="aegis_cannon.mesh" texture_filename="aegis_body.png" />
	<visual  offset="0 0 0" class="turret" turret_index="1" key="broken" mesh_filename="aegis_cannon.mesh" texture_filename="humvee_broken.png" />
	<visual  offset="0 0 0" class="turret" turret_index="2" mesh_filename="aegis_cannon.mesh" texture_filename="aegis_body.png" />
	<visual  offset="0 0 0" class="turret" turret_index="2" key="broken" mesh_filename="aegis_cannon.mesh" texture_filename="humvee_broken.png" />

	<visual class="track" mesh_filename="aegis_track_l.mesh" offset="1.65 0.36 -0.09" >
		<part texture_filename="is2_m1895_track.jpg" texture_animation="translate" factor="-0.1" tire_binding="1" />
		<part texture_filename="is2_m1895_track.jpg" texture_animation="translate" factor="-0.1" tire_binding="1" />
	</visual>

	<visual class="track" mesh_filename="aegis_track_r.mesh" offset="-1.65 0.36 -0.09" >
		<part texture_filename="is2_m1895_track.jpg" texture_animation="translate" factor="-0.1" tire_binding="0" />
		<part texture_filename="is2_m1895_track.jpg" texture_animation="translate" factor="-0.1" tire_binding="0" />

	</visual>

    <modifier class="blast_damage" value="-2.0" />

	<character_slot type="driver" position="0 0.8 1.8" rotation="0" exit_rotation="0" hiding="1" />
	<character_slot type="gunner" position="0 0.8 -1.8" seat_position="0 1.5 0" rotation="0" exit_rotation="3.14" hiding="1" >
		<turret index="0" />
		<turret index="1" />
		<turret index="2" /> 
		<turret index="3" /> 
	</character_slot>

	<spawn_point />

	<rev_sound filename="truck_rev0.wav" low_pitch="0.95" high_pitch="1.05" low_rev="0.0" high_rev="0.2" volume="1.0" />
	<rev_sound filename="truck_rev1.wav" low_pitch="0.8" high_pitch="1.1" low_rev="0.05" high_rev="0.7" volume="0.75" />
	<rev_sound filename="truck_rev3.wav" low_pitch="0.8" high_pitch="1.1" low_rev="0.4" high_rev="1.0" volume="1.0" />

	<sound key="slide" filename="slide_noise.wav" />
	<sound key="squeal" filename="tire_squeal.wav" />
	<sound key="ignition" filename="truck_ignition.wav" />
	<sound key="horn" filename="horn_truck.wav" />   
	<sound key="hit" filename="car_hit1.wav" />
	<sound key="hit" filename="car_hit2.wav" />
	<sound key="hit" filename="car_hit3.wav" />
	<sound key="destroy" filename="vehicle_explosion_1.wav" />   
	<sound key="cleanup" filename="vehicle_explosion_1.wav" />

	<effect event_key="drive" type="particle" key="terrain" ref="ct_vehicle_tire_smoke_3" use_surface_color="1" />
    <effect event_key="slide" type="particle" key="terrain" surface_tag="road" ref="ct_vehicle_tire_smoke_3" use_surface_color="1" />
	<effect event_key="slide_hard" type="particle" key="terrain" surface_tag="road" ref="ct_vehicle_tire_smoke_3" use_surface_color="1" />
	<effect event_key="slide" type="splat_map" surface_tag="road" size="1.0" atlas_index="5" layer="0" />
	<effect event_key="slide_hard" type="splat_map" surface_tag="road" size="0.5" atlas_index="2" layer="0" />
	<effect event_key="slide" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
	<effect event_key="slide" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />

	<effect event_key="health" value="60" ref="SmallSmokeVehicle" offset="-0.32 1.76 1" />
	<effect event_key="health" value="30" ref="SmallSmokeVehicle" offset="-0.32 1.76 1" />
	<effect event_key="health" value="30" ref="BrokenSparkle" post_processing="0" offset="-0.32 1.28 1" />
	<effect event_key="destroyed" ref="SmallSmokeVehicle" offset="-0.32 1.76 0.712" />
	<effect event_key="destroyed" ref="SmallFireRepeat" offset="-0.32 1.44 0.712" />
	<effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0.0 2.64 0" />
	
	<effect event_key="destroy" key="other" ref="woosh" post_processing="0" shadow="0" />   
	<effect event_key="cleanup" key="other" ref="woosh" post_processing="0" shadow="0" />  
  
	<event key="spot_rp_reward">
		<trigger class="spot" />
		<result class="reward" rp="50.0" />
	</event>

	<event key="destroy_rp_reward">
		<trigger class="destroy" />
		<result class="reward" rp="750.0" />
	</event>

	<event>
		<trigger class="destroy" />
  	<result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck1.visual_item" min_amount="1" max_amount="3" offset="0 2.4 0" position_spread="1.5 1.5" direction_spread="0.1 0.2" />
	</event>
	<event>
		<trigger class="destroy" />  	
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck2.visual_item" min_amount="2" max_amount="4" offset="0 2.4 0" position_spread="1.5 1.5" direction_spread="0.15 0.25" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck3.visual_item" min_amount="1" max_amount="2" offset="0 2.4 0" position_spread="1.5 1.5" direction_spread="0.1 0.18" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck4.visual_item" min_amount="1" max_amount="3" offset="0 2.4 0" position_spread="1.5 1.5" direction_spread="0.1 0.15" />
	</event>
  <event>
		<trigger class="destroy" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_truck5.visual_item" min_amount="2" max_amount="3" offset="0 2.4 0" position_spread="1.5 1.5" direction_spread="0.05 0.2" />
	</event>   

  <event>
		<trigger class="cleanup" />		
    <result class="spawn" instance_class="visual_item" instance_key="burning_piece_cleanup.visual_item" min_amount="20" max_amount="30" offset="0 2.0 0" position_spread="1.5 1.5" direction_spread="0.1 0.1" /> 
  </event>    
 	<event>
		<trigger class="cleanup" />
    <result class="spawn" instance_class="projectile" instance_key="debri_stun" min_amount="1" max_amount="1" offset="0 3.0 0" position_spread="0.0 0.0" direction_spread="0.0 0.0" />
  </event>   
</vehicle>
