<?xml version="1.0" encoding="utf-8"?>
<projectiles>
	<!-- 火箭妖精β分支 — 200伤害巡曳飞弹 -->
	<projectile class="grenade" name="" slot="2" key="fairy_rocket_cruise_missile_beta.projectile" >
		<tag name="rocket"/>
		<result class="blast" radius="7.5" damage="200.0" push="1.0" decal="1" faction_compare="not_equal" damage_origin_vehicle="0"/>
		<trigger class="impact" />
		<rotation class="motion" />
		<model mesh_filename="gk_rocket_shell.xml" />
		<commonness value="0.0" />

		<sound class="result" key="other" fileref="explosion_Large_FromSQUAD_1.wav" volume="2.0" />
		<sound class="result" key="other" fileref="explosion_Large_FromSQUAD_2.wav" volume="2.0" />

		<sound class="result" key="terrain" copy="other" />
		<sound class="result" key="static_object" copy="other" />
		<sound class="result" key="vehicle" copy="other" />
		<sound class="result" key="character" copy="other" />

		<effect class="result" key="terrain" ref="real_ground_crater" lighting="1" post_processing="1"/>
		<effect class="result" key="terrain" ref="real_up_dust_beam" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_up_dust_spread" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_up_dust_stone" lighting="1" post_processing="1"/>
		<effect class="result" key="terrain" ref="real_up_smoke_1" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="shadow_real_up_smoke_leave" lighting="1" post_processing="1"/>
		<effect class="result" key="terrain" ref="shadow_real_up_smoke_leave_2" lighting="1" post_processing="1"/>
		<effect class="result" key="terrain" ref="real_up_smoke_beam" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_up_impact_spread" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_up_impact_spark" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_up_impact_spark_2" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_up_impact_spark_1" lighting="1" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_smoke_1" lighting="1" post_processing="1"/>
		<effect class="result" key="terrain" ref="real_firesmoke_1" lighting="0" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_firesmoke_2" lighting="0" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_center_short_light" lighting="0" post_processing="0"/>
		<effect class="result" key="terrain" ref="real_center_ambient_light" lighting="0" post_processing="0"/>

		<effect class="result" type="splat_map" surface_tag="" size="10.0" atlas_index="0" layer="1" />
		<effect class="result" type="splat_map" surface_tag="" size="12.0" atlas_index="4" layer="0" />
		<effect class="result" type="splat_map" surface_tag="" size="14.0" atlas_index="0" layer="2" additive="0" />

		<effect class="result" key="other" copy="terrain"/>
		<effect class="result" key="static_object" copy="terrain" />
		<effect class="result" key="character" copy="terrain" />
		<effect class="result" key="shield" copy="terrain" />
		<effect class="result" key="vehicle" copy="terrain" />

		<trail probability="1.0" key="FlamethrowerTrail" />
		<effect class="activated" ref="Propulsion" />
	</projectile>

	<!-- 火箭妖精α分支 — 末敏弹头 -->
	<projectile class="grenade" name="" slot="2" key="fairy_rocket_submunition.projectile" >
		<result class="blast" radius="5.0" damage="80.0" push="0.4" decal="1" faction_compare="not_equal" damage_origin_vehicle="0"/>
		<trigger class="impact" />
		<rotation class="motion" />
		<model mesh_filename="mortar_shell.xml" />
		<commonness value="0.0" />

		<sound class="result" key="other" fileref="explosion_FromFC5_1.wav" volume="1.5" />
		<sound class="result" key="other" fileref="explosion_FromFC5_2.wav" volume="1.5" />

		<sound class="result" key="terrain" copy="other" />
		<sound class="result" key="static_object" copy="other" />
		<sound class="result" key="vehicle" copy="other" />
		<sound class="result" key="character" copy="other" />

		<effect class="result" key="terrain" ref="general_weapon_result_blast_smoke" lighting="0" post_processing="1"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_smoke_expanding" lighting="0" post_processing="1"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_ring" lighting="0"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_ring_2" lighting="0"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_spray_1" lighting="0"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_spray_2" lighting="0"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_fire" lighting="0"/> 
		<effect class="result" key="terrain" ref="general_weapon_result_blast_fire_wave" lighting="0"/> 

		<effect class="result" key="static_object" copy="terrain" />
		<effect class="result" key="vehicle" copy="terrain" />     
		<effect class="result" key="character" copy="terrain" />
		<effect class="result" key="other" copy="terrain" />

		<trail probability="1.0" key="FlamethrowerTrail" />
		<effect class="activated" ref="Propulsion" />
	</projectile>

	<!-- 火箭妖精β分支 — 反载具空爆 -->
	<projectile class="grenade" name="" slot="2" key="fairy_rocket_anti_vehicle_blast.projectile" >
		<result class="blast" radius="20.0" damage="200.0" push="1.0" decal="0" character_state="stun" faction_compare="not_equal" damage_origin_vehicle="0"/>
		<trigger class="time" time_to_live="0.0"/>
		<rotation class="random" />
		<model mesh_filename="" />
		<commonness value="0.0" />
	</projectile>

	<!-- 火箭妖精γ分支 — 高爆反人员地雷 -->
	<projectile
	class="grenade"
	name=""
	key="fairy_rocket_mine.projectile"
	slot="0"
	radius="1.2"
	on_ground_up="0 1 0"
	can_be_disarmed="0"
	can_be_detected_by_driver="0"
	can_be_detected_by_footmen="0"
	time_to_live_out_in_the_open="0.0"
	visible_height="-1.2"
	blast_damage_threshold="5"
	use_time_to_live="1"
	time_to_live="360">

		<result class="spawn" instance_class="projectile" instance_key="fairy_rocket_mine_sub.projectile" min_amount="20" max_amount="20" offset="0 0.8 0" position_spread="0 0" direction_spread="0 0" />
		<trigger class="impact">
			<collider class="terrain" enabled="0" />
			<collider class="static_object" enabled="0" />
			<collider class="vehicle" enabled="0"/>
			<collider class="character" enabled="1" faction_compare="not_equal" />
		</trigger>
		<collision class="sticky" />
		<rotation class="random" />

		<throwable curve_height="2.0" near_far_distance="2.0" speed_estimation_near="5.0" speed_estimation_far="5.0" max_speed="5.0" randomness="0.0" />

		<model mesh_filename="claymore_offset.mesh" texture_filename="at_mine.png" />
        <hud_icon filename="hud_claymore.png" />

		<commonness value="0.0" in_stock="0" can_respawn_with="0" />
		<capacity value="1" source="rank" source_value="0.2" />

		<inventory encumbrance="4.0" price="5.0" />

		<sound class="result" key="other" fileref="explosion_FromCOD16_1.wav" volume="2.8" />
		<sound class="result" key="other" fileref="explosion_FromCOD16_2.wav" volume="2.8" />
		<sound class="result" key="other" fileref="explosion_FromCOD16_3.wav" volume="2.8" />

		<sound class="result" key="terrain" copy="other" />
		<sound class="result" key="static_object" copy="other" />
		<sound class="result" key="vehicle" copy="other" />
		<sound class="result" key="character" copy="other" />

		<effect class="result" key="terrain" ref="BigBurst" use_surface_color="1" />
		<effect class="result" key="terrain" ref="SmokeTop" post_processing="1" />
		<effect class="result" key="terrain" ref="Smoke" post_processing="1" />
		<effect class="result" key="terrain" ref="Shine" lighting="0" />
		<effect class="result" key="terrain" ref="Godray" lighting="0" />
		<effect class="result" key="terrain" ref="ShadowSmoke" shadow="1" />
		<effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="0" layer="1" />
		<effect class="result" type="splat_map" surface_tag="" size="6.5" atlas_index="4" layer="0" />
		<effect class="result" type="splat_map" surface_tag="" size="8.0" atlas_index="0" layer="2" additive="0" />

		<effect class="result" key="other" ref="SmokeTop" post_processing="1" />
		<effect class="result" key="other" ref="Smoke" post_processing="1" />
		<effect class="result" key="other" ref="Shine" lighting="0" />
		<effect class="result" key="other" ref="Godray" lighting="0" />
		<effect class="result" key="other" ref="ShadowSmoke" shadow="1" />

		<effect class="result" key="static_object" copy="terrain" />
		<effect class="result" key="vehicle" copy="terrain" />
		<effect class="result" key="character" copy="terrain" />
	</projectile>

	<!-- 火箭妖精γ分支 — 地雷子母弹头 -->
	<projectile class="grenade" name="" slot="2" key="fairy_rocket_mine_sub.projectile" >
		<result class="blast" radius="8.0" damage="3.1" push="0.1" decal="0" character_state="death" faction_compare="not_equal" damage_origin_vehicle="0"/>
		<trigger class="time" time_to_live="0.0"/>
		<rotation class="random" />
		<model mesh_filename="" />
		<commonness value="0.0" />
	</projectile>
</projectiles>
