<?xml version="1.0" encoding="utf-8"?>
<projectiles>
	<!-- 基础VTOL机炮扫射 -->
	<projectile key="fairy_warrior_vtol_gsh23.projectile" slot="2" pulldown_in_air="0.0">
	    <result class="blast" damage="5.0" radius="4.0" decal="1" push="0.3" character_state="death" faction_compare="not_equal" damage_origin_vehicle="0"/>
	    <trail probability="1" key="BulletApTrail_ct"/>

	    <effect class="result" key="terrain" ref="hitGround_30mm" use_surface_color="1" />
	    <effect class="result" key="terrain" ref="BulletImpactDust4" />
	    <effect class="result" key="terrain" ref="BulletImpactDust5" />
	    <effect class="result" key="terrain" ref="BulletImpactDust6" />
	    <effect class="result" key="terrain" ref="MG_hvy_hit_leave_smaller" lighting="0" post_processing="1"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_1" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_2" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_3" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_4" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_hvy_spread_dust" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_hvy_hit_light" lighting="0" post_processing="1"/>

	    <effect class="result" key="static_object" copy="terrain" />
	    <effect class="result" key="vehicle" copy="terrain" />
	    <effect class="result" key="character" copy="terrain" />
	    <effect class="result" key="other" copy="terrain" />
	    <trail probability="1.0" key="BulletApTrail_ct" />

	    <effect class="activated" ref="general_weapon_activated_bullet_light" lighting="0"/>
	    <effect class="activated" ref="general_weapon_activated_bullet_centerlight" lighting="0"/>

	    <effect class="result" type="splat_map" surface_tag="" size="3.0" atlas_index="0" layer="1" />
	    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="4" layer="0" />
	    <effect class="result" type="splat_map" surface_tag="" size="6.0" atlas_index="0" layer="2" additive="0" />

	    <model mesh_filename="paw20_round.xml" />
	    <trigger class="impact" />
	    <rotation class="motion" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_1.wav" volume="2.0" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_2.wav" volume="2.0" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_3.wav" volume="2.0" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_4.wav" volume="2.0" />
	    <sound class="result" key="terrain" copy="other" />
	    <sound class="result" key="static_object" copy="other" />
	    <sound class="result" key="vehicle" copy="other" />
	    <sound class="result" key="character" copy="other" />
	</projectile>

	<!-- α分支机炮扫射 -->
	<projectile key="fairy_warrior_vtol_gsh23_alpha.projectile" slot="2" pulldown_in_air="0.0">
	    <result class="blast" damage="6.1" radius="5.0" decal="1" push="0.3" character_state="death" faction_compare="not_equal" damage_origin_vehicle="0"/>
	    <trail probability="1" key="BulletApTrail_ct"/>

	    <effect class="result" key="terrain" ref="hitGround_30mm" use_surface_color="1" />
	    <effect class="result" key="terrain" ref="BulletImpactDust4" />
	    <effect class="result" key="terrain" ref="BulletImpactDust5" />
	    <effect class="result" key="terrain" ref="BulletImpactDust6" />
	    <effect class="result" key="terrain" ref="MG_hvy_hit_leave_smaller" lighting="0" post_processing="1"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_1" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_2" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_3" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_heavy_up_dust_4" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_hvy_spread_dust" lighting="0"/>
	    <effect class="result" key="terrain" ref="MG_hvy_hit_light" lighting="0" post_processing="1"/>

	    <effect class="result" key="static_object" copy="terrain" />
	    <effect class="result" key="vehicle" copy="terrain" />
	    <effect class="result" key="character" copy="terrain" />
	    <effect class="result" key="other" copy="terrain" />
	    <trail probability="1.0" key="BulletApTrail_ct" />

	    <effect class="activated" ref="general_weapon_activated_bullet_light" lighting="0"/>
	    <effect class="activated" ref="general_weapon_activated_bullet_centerlight" lighting="0"/>

	    <effect class="result" type="splat_map" surface_tag="" size="3.0" atlas_index="0" layer="1" />
	    <effect class="result" type="splat_map" surface_tag="" size="5.0" atlas_index="4" layer="0" />
	    <effect class="result" type="splat_map" surface_tag="" size="6.0" atlas_index="0" layer="2" additive="0" />

	    <model mesh_filename="paw20_round.xml" />
	    <trigger class="impact" />
	    <rotation class="motion" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_1.wav" volume="2.0" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_2.wav" volume="2.0" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_3.wav" volume="2.0" />
	    <sound class="result" key="other" fileref="apache_bullet_hit_layer_4.wav" volume="2.0" />
	    <sound class="result" key="terrain" copy="other" />
	    <sound class="result" key="static_object" copy="other" />
	    <sound class="result" key="vehicle" copy="other" />
	    <sound class="result" key="character" copy="other" />
	</projectile>

	<!-- β分支救援unwound弹头 -->
	<projectile class="grenade" name="" slot="2" key="fairy_warrior_vtol_unwound.projectile">
	    <result class="blast" radius="3.0" damage="0.0" push="0.0" decal="0" character_state="unwound" faction_compare="equal" make_vehicle_hit_sound="0" />
	    <trigger class="time" time_to_live="0.0"/>
	    <rotation class="random" />
	    <model mesh_filename="" />
	    <commonness value="0.0" />
	</projectile>
</projectiles>
