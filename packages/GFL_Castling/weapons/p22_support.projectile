<?xml version="1.0" encoding="utf-8"?>
<projectiles>
    <!-- Repair callback and green medical-crate-style wave at the selected point. -->
    <projectile class="grenade" key="p22_repair_notify.projectile" name=""
                slot="0" radius="0.0" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0">
        <result class="notify_script" key="p22_repair" />
        <trigger class="time" time_to_live="0.0" />
        <rotation class="none" />
        <model />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
        <effect class="result" key="terrain" ref="ct_heal_woosh_10rad" lighting="0" />
        <effect class="result" key="other" copy="terrain" />
        <effect class="result" key="static_object" copy="terrain" />
        <effect class="result" key="vehicle" copy="terrain" />
        <effect class="result" key="character" copy="terrain" />
    </projectile>

    <!-- One nonlethal, enemy-only flash and supply callback at the actual impact. -->
    <projectile class="grenade" key="p22_flash_supply.projectile" name=""
                slot="0" radius="0.0" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0">
        <tag name="flashbang" />
        <result class="blast" radius="10.0" damage="0.0" push="0.0" decal="0"
                character_state="stun" faction_compare="not_equal" damage_origin_vehicle="0" />
        <result class="notify_script" key="p22_supply" />
        <trigger class="time" time_to_live="0.0" />
        <rotation class="none" />
        <model />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
        <sound class="result" key="other" fileref="stun_grenade1.wav" />
        <sound class="result" key="terrain" copy="other" />
        <sound class="result" key="static_object" copy="other" />
        <sound class="result" key="vehicle" copy="other" />
        <sound class="result" key="character" copy="other" />
        <effect class="result" key="other" ref="FlashShine" lighting="0" />
        <effect class="result" key="other" ref="FlashBeam" lighting="0" />
        <effect class="result" key="terrain" copy="other" />
        <effect class="result" key="static_object" copy="other" />
        <effect class="result" key="vehicle" copy="other" />
        <effect class="result" key="character" copy="other" />
    </projectile>
    <!-- Visible carriers fly from the caster to A; cover can intercept the throw. -->
    <projectile class="grenade" key="p22_flash_grenade.projectile" name=""
                slot="0" radius="0.15" pulldown_in_air="26.0" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0"
                use_time_to_live="1" time_to_live="8.0">
        <result class="spawn" instance_class="grenade" instance_key="p22_flash_supply.projectile"
                min_amount="1" max_amount="1" offset="0 0.1 0" position_spread="0 0" direction_spread="0 0" />
        <trigger class="impact">
            <collider class="terrain" enabled="1" />
            <collider class="static_object" enabled="1" />
            <collider class="vehicle" enabled="1" />
            <collider class="character" enabled="0" />
        </trigger>
        <rotation class="random" />
        <model mesh_filename="stun_grenade.xml" />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
    </projectile>

    <projectile class="grenade" key="p22_smoke_grenade.projectile" name=""
                slot="0" radius="0.15" pulldown_in_air="26.0" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0"
                use_time_to_live="1" time_to_live="8.0">
        <result class="spawn" instance_class="grenade" instance_key="smoke_grenade.projectile"
                min_amount="1" max_amount="1" offset="0 0.1 0" position_spread="0 0" direction_spread="0 0" />
        <trigger class="impact">
            <collider class="terrain" enabled="1" />
            <collider class="static_object" enabled="1" />
            <collider class="vehicle" enabled="1" />
            <collider class="character" enabled="0" />
        </trigger>
        <rotation class="random" />
        <model mesh_filename="grenade.xml" />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
        <effect class="activated" ref="ThrownSmokeGrenade" />
    </projectile>

    <!-- Conservative particle.projectile template: short zero-damage bursts only. -->
    <projectile class="grenade" key="p22_beacon_pulse.projectile" name=""
                slot="0" radius="0.01" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0">
        <result class="blast" radius="0.0" damage="0.0" push="0.0" decal="0"
                character_state="none" make_vehicle_hit_sound="0" />
        <trigger class="time" time_to_live="0.01" />
        <rotation class="none" />
        <model />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
        <effect class="result" key="terrain" ref="p22_griffin_beacon_sign" lighting="0" />
        <effect class="result" key="terrain" ref="p22_griffin_beacon_ring" lighting="0" />
        <effect class="result" key="other" copy="terrain" />
        <effect class="result" key="static_object" copy="terrain" />
        <effect class="result" key="vehicle" copy="terrain" />
        <effect class="result" key="character" copy="terrain" />
    </projectile>

    <projectile class="grenade" key="p22_supply_feedback.projectile" name=""
                slot="0" radius="0.01" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0">
        <result class="blast" radius="0.0" damage="0.0" push="0.0" decal="0"
                character_state="none" make_vehicle_hit_sound="0" />
        <trigger class="time" time_to_live="0.01" />
        <rotation class="none" />
        <model />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
        <effect class="result" key="terrain" ref="p22_grenade_plus" lighting="0" />
        <effect class="result" key="other" copy="terrain" />
        <effect class="result" key="static_object" copy="terrain" />
        <effect class="result" key="vehicle" copy="terrain" />
        <effect class="result" key="character" copy="terrain" />
    </projectile>

    <projectile class="grenade" key="p22_heal_feedback.projectile" name=""
                slot="0" radius="0.01" can_be_disarmed="0"
                can_be_detected_by_driver="0" can_be_detected_by_footmen="0">
        <result class="blast" radius="0.0" damage="0.0" push="0.0" decal="0"
                character_state="none" make_vehicle_hit_sound="0" />
        <trigger class="time" time_to_live="0.01" />
        <rotation class="none" />
        <model />
        <commonness value="0.0" in_stock="0" can_respawn_with="0" />
        <sound class="result" key="other" fileref="stim_hit.wav" volume="0.45" />
        <sound class="result" key="terrain" copy="other" />
        <sound class="result" key="static_object" copy="other" />
        <sound class="result" key="vehicle" copy="other" />
        <sound class="result" key="character" copy="other" />
        <effect class="result" key="terrain" ref="emoticon_heal_cross_cyan" lighting="0" />
        <effect class="result" key="other" copy="terrain" />
        <effect class="result" key="static_object" copy="terrain" />
        <effect class="result" key="vehicle" copy="terrain" />
        <effect class="result" key="character" copy="terrain" />
    </projectile>
</projectiles>
