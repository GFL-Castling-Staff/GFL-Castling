// P22: ct_woosh.particle ground rings, 98k_medal.particle floating icons,
// with quota limited to four each. Healing reuses existing shared particles.
// No long-lived particle emitter is left behind when a selection is cancelled.
particle_system p22_griffin_beacon_sign
{
    quota 4
    material p22_griffin_badge
    particle_width 2.8
    particle_height 2.8
    renderer billboard
    billboard_type point
    emitter Point
    {
        colour 1 1 1 0.95
        position 0 3.2 0
        direction 0 1 0
        velocity 0
        emission_rate 40
        duration 0.03
        time_to_live 0.65
    }
    affector ColourFader2
    {
        alpha1 0
        alpha2 -5
        state_change 0.45
    }
}

particle_system p22_griffin_beacon_ring
{
    quota 4
    material woosh
    particle_width 3.5
    particle_height 3.5
    renderer billboard
    billboard_type perpendicular_common
    common_direction 0 1 0
    common_up_vector 0 0 1
    emitter Point
    {
        colour 0.95 0.59 0.20 0.8
        position 0 0.15 0
        direction 0 1 0
        velocity 0
        emission_rate 40
        duration 0.03
        time_to_live 0.6
    }
    affector Scaler
    {
        rate 4
    }
    affector ColourFader
    {
        alpha -1.3
    }
}

particle_system p22_grenade_plus
{
    quota 4
    material p22_grenade_plus_icon
    particle_width 3.2
    particle_height 1.6
    renderer billboard
    billboard_type point
    emitter Point
    {
        colour 1 1 1 1
        position 0 3.0 0
        direction 0 1 0
        velocity 0.6
        emission_rate 40
        duration 0.03
        time_to_live 1.2
    }
    affector ColourFader2
    {
        alpha1 0
        alpha2 -2
        state_change 0.7
    }
}

material p22_griffin_badge
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            fog_override true
            depth_write off
            scene_blend alpha_blend
            texture_unit
            {
                texture p22_griffin_beacon.png
                tex_address_mode clamp
            }
        }
    }
}

material p22_grenade_plus_icon
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            fog_override true
            depth_write off
            scene_blend alpha_blend
            texture_unit
            {
                texture p22_grenade_plus.png
                tex_address_mode clamp
            }
        }
    }
}
