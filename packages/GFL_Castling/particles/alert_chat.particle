particle_system alert_chat_marker
{
	quota 50
	material alert_marker
	particle_width 16
	particle_height 16
	renderer billboard
	billboard_type perpendicular_common
	billboard_origin center
	billboard_rotation_type vertex
	common_direction 0 1 0
	common_up_vector 0 0 1
	
	emitter Point
	{
		angle 0
		direction 0 1 0
        colour  1.0 0.2 0.2 0.3
		emission_rate 1
		position 0 1 0
		velocity 0.001
		time_to_live 1.0
		duration 5.0
	}

	affector ColourFader
	{
		red	-1.0
		green	-1.0
		blue	-1.0
		alpha	-0.4
	}

	affector Scaler
	{
		rate -5
	}
}

particle_system alert_chat_sign
{
	quota 50
	material alert_sign
	particle_width 20
	particle_height 20
	renderer billboard
	billboard_type point
	billboard_origin center
	billboard_rotation_type vertex
	common_direction 0 1 0
	common_up_vector 0 0 1
	iteration_interval 0

	emitter Point
	{
		angle 0
		colour 1 1 1 0.5
		direction 0 1 0
		emission_rate 1
		position 0 3 0
		velocity 0.001
		time_to_live 1.0
		duration 5.0
	}

	affector ColourFader
	{
		red	-0.0
		green	-0.0
		blue	-0.0
		alpha	-0.6
	}
}


material alert_marker : alpha_blend_base
{   
    technique{
    pass{
        texture_unit{
            texture alert_marker.png
}}}}

material alert_sign : no_depth_alpha_blend_base
{   
    technique{
    pass{
		depth_func always_pass
        texture_unit{
            texture comms_marker_flag_small.png
}}}}


material alpha_blend_base{
	receive_shadows off
	technique{
		pass{
			lighting off
			fog_override true
			scene_blend alpha_blend
		}
	}
}

material no_depth_alpha_blend_base{
	receive_shadows off
	technique{
		pass{
			lighting off
			fog_override true
			depth_write off
			scene_blend alpha_blend
		}
	}
}