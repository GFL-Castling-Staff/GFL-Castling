	<animation key="crouching forwards" target_key="arachne_clone_walk" />
	<animation key="crouching backwards" target_key="arachne_clone_walk_backward" />
	<animation key="prone" target_key="arachne_clone_still" />
	<animation key="prone, moving forwards" target_key="arachne_clone_walk" />
	<animation key="going prone" target_key="arachne_clone_still" />
	<animation key="leaving prone" target_key="arachne_clone_still" />
	<animation key="dive" target_key="arachne_clone_dive" />
	<animation key="jumping" target_key="arachne_clone_jump" />
	<animation key="lifting up" target_key="arachne_clone_lift_up" />
	<animation key="throwing self over" target_key="arachne_clone_lift_foward" />
	<animation key="throwing, upside" target_key="arachne_clone_throw_still" />
	<animation key="falling" target_key="arachne_clone_dive" />
	<animation key="arriving ground" target_key="arachne_clone_landing" />
	<animation key="climbing ladder, still" target_key="arachne_clone_climb_still" />
	<animation key="climbing ladder" target_key="arachne_clone_climb" />
	<animation key="climbing ladder ending" target_key="arachne_clone_climb_leave" />
	<animation key="stunned" target_key="arachne_clone_stun" />
	<animation key="tank mg still" target_key="arachne_clone_still" />
	<animation key="stabbing" target_key="arachne_clone_melee" />
